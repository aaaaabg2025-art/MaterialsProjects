# Python临时文件
**/__pycache__/
*.pyc

# 23_sim中的VASP计算目录
ASE-learning/23_sim/vasp_*/

# ASE优化过程文件
*.traj
*.log

# 计算结果表格和结构
ASE-learning/23_sim/*.csv
ASE-learning/23_sim/*.xyz

# VASP大型输出和重启文件
**/OUTCAR
**/vasprun.xml
**/WAVECAR
**/CHGCAR
**/CHG
**/DOSCAR
**/EIGENVAL
**/PCDAT
**/XDATCAR

# VASP许可文件，禁止上传
**/POTCAR

# VASP static learning calculations (outputs only; Python scripts remain trackable)
VASP/static/vasp_*/
VASP/static/*.traj
VASP/static/*.log
VASP/static/*.xyz
VASP/static/*.csv

# GRACE local runtime: virtual environment, downloaded models, and generated output
GRACE/.venv/
GRACE/.env
GRACE/models/
GRACE/prediction.extxyz
GRACE/tools/
GRACE/uvcache*/
